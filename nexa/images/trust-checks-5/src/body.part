.rv{display:flex;gap:18px;padding:22px 30px;border-bottom:1px solid #f0eff4}
.av{width:54px;height:54px;border-radius:50%;flex:none;display:flex;align-items:center;justify-content:center;font:700 22px Inter;color:#fff}
.stars{color:#f5a623;font-size:22px;letter-spacing:2px}
.blur{filter:blur(5px)}
.chip{display:inline-block;font:600 19px Inter;padding:8px 14px;border-radius:10px;background:#f1effa;color:#3d3480;margin:0 8px 8px 0}
</style></head><body>

<!-- 1 cover -->
<div class="s" id="s1">
 <div class="ph" style="height:1350px"><img src="img/hero.jpg" style="object-position:40% 50%"></div>
 <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(21,12,43,.10) 0%,rgba(21,12,43,.40) 32%,rgba(21,12,43,.97) 60%)"></div>
 <div class="card" style="left:330px;right:70px;top:110px;transform:rotate(3deg);box-shadow:0 30px 70px rgba(0,0,0,.5)">
  <div class="bar"><span class="d"></span><span class="url"><b>tidewireelectrical</b>.com.au</span></div>
  <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 24px;font:800 22px 'DM Sans';color:#0f3b5c">Tidewire Electrical<i style="font:500 14px Inter;font-style:normal;color:#8a8794">Services &nbsp;About &nbsp;Reviews &nbsp;Contact</i></div>
  <div style="position:relative;height:250px;background:url(img/wire2.jpg) 50% 60%/cover">
   <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,30,50,.75),rgba(10,30,50,.1))"></div>
   <div style="position:absolute;left:24px;top:40px;width:320px;color:#fff;font:700 30px/1.1 'DM Sans'">Your local sparky in Newcastle</div>
   <div style="position:absolute;left:24px;top:160px;background:#f5a623;color:#0f3b5c;font:700 16px Inter;padding:10px 18px;border-radius:8px">Get a quote</div></div>
 </div>
 <div class="note" style="left:120px;top:330px;transform:rotate(-6deg);font-size:38px">would you<br>call them?</div>
 <div class="h" style="top:620px;font-size:98px;z-index:6">Customers check these 5 things <em>before they call you</em></div>
 <div class="sub" style="top:1105px;font-size:36px;color:#E4DEFF;z-index:6">Does your website pass? Swipe &#8594;</div>
 <div class="ft" style="z-index:6"><span>@nexaweb_dev</span><span class="dots" data-on="1"></span></div>
</div>

<!-- 2 prices -->
<div class="s" id="s2">
 <div class="ph"><img src="img/desk.jpg" style="object-position:50% 50%"></div><div class="num">01</div>
 <div class="h">No prices. <em>Anywhere.</em></div>
 <div class="sub">So they check the next site that has them.</div>
 <div class="card" style="top:610px;transform:rotate(-1deg)">
  <div class="bar"><span class="d"></span><span class="url"><b>tidewireelectrical</b>.com.au/services</span></div>
  <div class="row"><span>Power point installed</span><span class="v"><span class="mk">from $150</span></span></div>
  <div class="row"><span>Ceiling fan installed</span><span class="v">from $220</span></div>
  <div class="row"><span>Safety switch check</span><span class="v">from $99</span></div>
  <div style="padding:20px 34px 24px;font-size:22px;color:#8a8794">Exact price confirmed before we start. No surprises.</div></div>
 <div class="note" style="left:500px;top:1040px;transform:rotate(-2deg)">a rough guide is enough</div>
 <div class="why" style="top:1125px"><b>Fix:</b> show "from" prices or a typical range. Nobody wants to ring just to find out if they can afford you.</div>
 <div class="ft"><span>@nexaweb_dev</span><span class="dots" data-on="2"></span></div>
</div>

<!-- 3 reviews -->
<div class="s" id="s3">
 <div class="ph"><img src="img/phone.jpg" style="object-position:50% 35%"></div><div class="num">02</div>
 <div class="h">Reviews with <em>no names</em></div>
 <div class="sub">"Great service!! J." convinces nobody.</div>
 <div class="card" style="top:600px;transform:rotate(1deg)">
  <div class="bar"><span class="d"></span>What customers say</div>
  <div class="rv" style="opacity:.45"><div class="av" style="background:#c9c6d2">?</div><div><div style="font:600 24px Inter">J.</div><div style="font-size:24px;margin-top:4px">"Great service!!"</div></div><span class="chk" style="background:#d93a3a;margin-left:auto">&#10005;</span></div>
  <div class="rv" style="border:0;padding-bottom:28px"><div class="av" style="background:#2f8f6d">SP</div><div style="flex:1"><div style="font:600 24px Inter">Sarah P. <span style="font:400 20px Inter;color:#8a8794">&#183; 2 weeks ago &#183; Google</span></div><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><div style="font-size:23px;line-height:1.4;margin-top:6px">"Found the fault in our kitchen lights in 20 minutes, explained it, and <span class="mk">the bill matched the quote.</span>"</div></div><span class="chk" style="margin-left:6px">&#10003;</span></div></div>
 <div class="why" style="top:1100px"><b>Fix:</b> show real Google reviews with names and dates, and link to them. Never write your own. Fake reviews break Australian Consumer Law.</div>
 <div class="ft"><span>@nexaweb_dev</span><span class="dots" data-on="3"></span></div>
</div>

<!-- 4 who -->
<div class="s" id="s4">
 <div class="ph"><img src="img/wire.jpg" style="object-position:50% 60%"></div><div class="num">03</div>
 <div class="h">Nobody knows <em>who you are</em></div>
 <div class="sub">No names, no faces. Feels like a risk.</div>
 <div class="card" style="top:610px;transform:rotate(-1deg)">
  <div class="bar"><span class="d"></span><span class="url"><b>tidewireelectrical</b>.com.au/about</span></div>
  <div style="display:flex;gap:28px;padding:30px">
   <div style="width:250px;height:250px;border-radius:16px;background:url(img/tools.jpg) 70% 50%/cover;flex:none"></div>
   <div><div style="font:800 34px 'DM Sans';color:#0f3b5c">Hi, I'm Mick.</div>
    <div style="font-size:23px;line-height:1.4;margin:10px 0 16px;color:#44414b">Licensed electrician, 14 years around Newcastle. <span class="mk">I answer the phone myself.</span></div>
    <span class="chip">Licence no. <span class="blur">123456C</span></span><span class="chip">Fully insured</span></div></div></div>
 <div class="why" style="top:1110px"><b>Fix:</b> a short About bit with your name, a real photo of you or the team, and your licence number if your trade needs one.</div>
 <div class="ft"><span>@nexaweb_dev</span><span class="dots" data-on="4"></span></div>
</div>

<!-- 5 what happens next -->
<div class="s" id="s5">
 <div class="ph"><img src="img/tap.jpg" style="object-position:50% 50%"></div><div class="num">04</div>
 <div class="h">No idea <em>what happens next</em></div>
 <div class="sub">They hit "Submit" and then... silence?</div>
 <div class="card" style="top:600px;transform:rotate(1deg)">
  <div class="bar"><span class="d"></span><span class="url"><b>tidewireelectrical</b>.com.au/contact</span></div>
  <div class="lbl">Your name</div><div class="fld">Dan</div>
  <div class="lbl">What do you need?</div><div class="fld">Two power points in the garage</div>
  <div style="margin:22px 30px 26px;border-radius:16px;background:#e9f7ef;border:1.5px solid #9fd9b8;padding:20px 22px;font-size:24px;line-height:1.45;color:#1d5b3a"><b>Thanks Dan!</b> <span class="mk">Mick will call you back within 1 business day.</span> Urgent? Call 0491 570 156.</div></div>
 <div class="why" style="top:1130px"><b>Fix:</b> tell people exactly what happens after they hit send, and how fast. Then actually do it.</div>
 <div class="ft"><span>@nexaweb_dev</span><span class="dots" data-on="5"></span></div>
</div>

<!-- 6 footer -->
<div class="s" id="s6">
 <div class="ph"><img src="img/laptop.jpg" style="object-position:50% 45%"></div><div class="num">05</div>
 <div class="h">A footer stuck in <em>2019</em></div>
 <div class="sub">People scroll right down to check you're real.</div>
 <div class="card" style="top:600px;transform:rotate(-1deg)">
  <div style="background:#2b2b2f;color:#9b9aa3;padding:22px 30px;font-size:22px;display:flex;justify-content:space-between"><span><span class="mk" data-c="1">&#169; 2019</span> Tidewire</span><span>Home | Contact</span></div>
  <div style="text-align:center;font:700 22px Inter;color:#8a8794;padding:12px 0">&#8595; better &#8595;</div>
  <div style="background:#0f3b5c;color:#dfe8f0;padding:26px 30px;display:flex;gap:30px;font-size:21px;line-height:1.6">
   <div style="flex:1.1"><div style="font:800 25px 'DM Sans';color:#fff">Tidewire Electrical</div>ABN <span class="blur">12 345 678 901</span><br>Newcastle &amp; Lake Macquarie</div>
   <div style="flex:1">0491 570 156<br>Mon to Fri, 7am to 5pm<br>&#169; 2026</div></div></div>
 <div class="note" style="left:560px;top:1035px;transform:rotate(-2deg)">small stuff, big trust</div>
 <div class="why" style="top:1110px"><b>Fix:</b> business name, ABN, the area you cover, phone, hours, and this year's date. Takes 5 minutes.</div>
 <div class="ft"><span>@nexaweb_dev</span><span class="dots" data-on="6"></span></div>
</div>

<!-- 7 cta -->
<div class="s" id="s7">
 <div class="h" style="top:110px;font-size:84px">How many does your site <em>pass?</em></div>
 <div id="list" style="position:absolute;left:80px;right:80px;top:330px;z-index:3;display:flex;flex-direction:column;gap:16px"></div>
 <div style="position:absolute;left:80px;right:80px;top:960px;font-size:36px;line-height:1.5;color:#D9D3F2;z-index:3">Comment your score out of 5 &#128071;<br>Save this for your next website update.<br>Follow <b style="color:var(--lav)">@nexaweb_dev</b> for more like this.</div>
 <div class="ft"><span>@nexaweb_dev</span><span class="dots" data-on="7"></span></div>
</div>

<script>
document.querySelectorAll('.dots').forEach(d=>{const on=+d.dataset.on;d.innerHTML=[...Array(7)].map((_,i)=>`<span class="${i+1===on?'on':''}"></span>`).join('')});
const items=[['Prices, even rough ones','desk'],['Real reviews with names','phone'],['A real person behind it','tools'],['Says what happens next','tap'],['An up to date footer','laptop']];
